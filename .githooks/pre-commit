#!/bin/bash
# Nada se commitea con algo en rojo (L56). Solo si el commit toca código, tests, listas o el simulador.
# Saltárselo a sabiendas: git commit --no-verify (y decir por qué).
cambios=$(git diff --cached --name-only -- src tests config scripts/simular.py ruff.toml)
[ -z "$cambios" ] && exit 0
echo "pre-commit: comprobando antes de commitear…"
raiz=$(git rev-parse --show-toplevel)
# Sin las variables que fijan el repo: en un worktree van con ruta absoluta y un `git` lanzado
# por los tests escribiría en este repositorio (L60).
unset $(git rev-parse --local-env-vars)
cd "$raiz" && exec "$raiz/scripts/verificar.sh"
